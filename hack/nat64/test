#!/usr/bin/env bash
# Tests NAT64 on the node (crates/nat64) in network namespaces of its own:
#
#   pod (IPv6 only) -- node (feos-nat64, masquerade) -- router -- internet (IPv4 only)
#   fd00:fe05::2       198.51.100.2               .1  192.0.2.254     192.0.2.1
#
# Needs sudo, iptables (the masquerade, in the node's namespace), nc
# (OpenBSD), python3 and nsenter. Besides its namespaces it touches only its
# pin directory, /sys/fs/bpf/feos-nat64-test, and removes both.
set -euo pipefail
cd "$(dirname "$0")/../.."

cargo build -p nat64 --example nat64
BIN=$PWD/target/debug/examples/nat64
PIN_DIR=/sys/fs/bpf/feos-nat64-test
POD=fd00:fe05::2
UNMAPPED=fd00:fe05::3
POD4=10.200.0.2
SERVER=192.0.2.1
SERVER6=64:ff9b::c000:201
NODE_UP=198.51.100.2
ROUTER_DOWN=198.51.100.1
SIZE_MB=${SIZE_MB:-100}
WORK=$(mktemp -d)
FAILED=0

ns() {
	local name=$1
	shift
	sudo ip netns exec "nat64-$name" "$@"
}
# The loader joins the node's network namespace only: `ip netns exec` would
# also hide the host's /sys/fs/bpf.
nat64() { sudo nsenter --net=/run/netns/nat64-node "$BIN" --pin-dir "$PIN_DIR" "$@"; }
counter() { nat64 stats | awk -v name="$1" '$1 == name { print $2 }'; }
pass() { echo "PASS: $*"; }
fail() {
	echo "FAIL: $*"
	FAILED=1
}

cleanup() {
	for name in pod node router internet; do
		sudo ip netns pids "nat64-$name" 2>/dev/null | xargs -r sudo kill 2>/dev/null || true
		sudo ip netns del "nat64-$name" 2>/dev/null || true
	done
	sudo rm -rf "$PIN_DIR"
	rm -rf "$WORK"
}
# `hack/nat64/test cleanup` removes what KEEP=1 kept for a look.
if [ "${1:-}" = cleanup ]; then
	cleanup
	exit
fi
if [ -n "${KEEP:-}" ]; then
	trap 'echo "Kept the namespaces nat64-*; hack/nat64/test cleanup removes them."' EXIT
else
	trap cleanup EXIT
fi

echo "== Topology"
for name in pod node router internet; do
	sudo ip netns add "nat64-$name"
	ns "$name" ip link set lo up
	ns "$name" sysctl -qw net.ipv6.conf.all.accept_dad=0 net.ipv6.conf.default.accept_dad=0
done

# The pod's TAP: a point-to-point link, the node is fe80::1 on it.
ns pod ip link add eth0 type veth peer name pod-test netns nat64-node
ns pod ip link set eth0 up
ns pod ip -6 addr add "$POD/128" dev eth0 nodad
# Deprecated: the pod sends from it only when told to.
ns pod ip -6 addr add "$UNMAPPED/128" dev eth0 nodad preferred_lft 0
ns pod ip -6 route add default via fe80::1 dev eth0
ns node ip link set pod-test up
ns node ip -6 addr add fe80::1/64 dev pod-test nodad
ns node ip -6 route add "$POD/128" dev pod-test
ns node ip -6 route add "$UNMAPPED/128" dev pod-test

# The node's uplink, and the pool masqueraded to it.
ns node ip link add uplink type veth peer name r-node netns nat64-router
ns node ip link set uplink up
ns node ip addr add "$NODE_UP/24" dev uplink
ns node ip route add default via "$ROUTER_DOWN"
ns node iptables -t nat -A POSTROUTING -s 10.200.0.0/16 -o uplink -j MASQUERADE

ns router ip link set r-node up
ns router ip addr add "$ROUTER_DOWN/24" dev r-node
ns router ip link add r-inet type veth peer name eth0 netns nat64-internet
ns router ip link set r-inet up
ns router ip addr add 192.0.2.254/24 dev r-inet
ns router sysctl -qw net.ipv4.ip_forward=1

ns internet ip link set eth0 up
ns internet ip addr add "$SERVER/24" dev eth0
ns internet ip route add default via 192.0.2.254

echo "== Attach"
nat64 attach
nat64 map "$POD" "$POD4"
if ns node ip -o link show feos-nat64 | grep -q NOARP; then
	pass "feos-nat64 is up without ARP"
else
	fail "feos-nat64 has ARP"
fi
ns node ip route show dev feos-nat64
ns node ip -6 route show dev feos-nat64
ns node tc filter show dev feos-nat64 egress
ns pod ethtool -k eth0 | grep -E '^(tcp-segmentation-offload|generic-segmentation-offload):'
# KEEP=1 SETUP_ONLY=1: the topology, to look at by hand.
if [ -n "${SETUP_ONLY:-}" ]; then
	exit 0
fi

echo "== ICMP echo"
if ns pod ping -6 -c 5 -i 0.2 -W 2 "$SERVER6" | tee "$WORK/ping" | grep -q ' 5 received'; then
	pass "ping $SERVER6: $(grep -o 'rtt.*' "$WORK/ping")"
else
	fail "ping $SERVER6"
	cat "$WORK/ping"
fi

echo "== Denied destinations"
denied=$(counter denied)
ns pod ping -6 -c 1 -W 1 64:ff9b::7f00:1 >/dev/null 2>&1 || true
ns pod ping -6 -c 1 -W 1 64:ff9b::ac8:5 >/dev/null 2>&1 || true
if [ "$(counter denied)" -ge $((denied + 2)) ]; then
	pass "64:ff9b::127.0.0.1 and 64:ff9b::10.200.0.5 (the pool) are dropped"
else
	fail "denied destinations went through"
fi

echo "== TCP, $SIZE_MB MB each way"
head -c "${SIZE_MB}M" /dev/urandom >"$WORK/data"
sum=$(sha256sum <"$WORK/data")
transfer() {
	local what=$1 server=$2 client=$3
	ns internet timeout 120 sh -c "$server" &
	local server_pid=$!
	sleep 0.5
	local start end
	start=$(date +%s.%N)
	ns pod timeout 120 sh -c "$client"
	wait "$server_pid"
	end=$(date +%s.%N)
	awk -v what="$what" -v mb="$SIZE_MB" -v start="$start" -v end="$end" \
		'BEGIN { printf "%s: %d MB in %.2f s, %.0f MB/s\n", what, mb, end - start, mb / (end - start) }'
}
transfer download "nc -l -N $SERVER 5001 <$WORK/data" "nc -d $SERVER6 5001 | sha256sum >$WORK/down"
transfer upload "nc -l -d $SERVER 5002 | sha256sum >$WORK/up" "nc -N $SERVER6 5002 <$WORK/data"
if [ "$(cat "$WORK/down")" = "$sum" ]; then pass "download intact"; else fail "download corrupt"; fi
if [ "$(cat "$WORK/up")" = "$sum" ]; then pass "upload intact"; else fail "upload corrupt"; fi

echo "== UDP"
cat >"$WORK/udp-server.py" <<'EOF'
import select, socket
socks = []
for port, checksum in ((5003, True), (5004, False)):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    if not checksum:
        s.setsockopt(socket.SOL_SOCKET, 11, 1)  # SO_NO_CHECK: send without a checksum
    s.bind(("192.0.2.1", port))
    socks.append(s)
while True:
    for s in select.select(socks, [], [])[0]:
        data, peer = s.recvfrom(65535)
        s.sendto(data, peer)
EOF
cat >"$WORK/udp-client.py" <<'EOF'
import os, socket, sys
server = sys.argv[1]
ok = 0
for port in (5003, 5004):
    for size in (16, 600, 1400):
        s = socket.socket(socket.AF_INET6, socket.SOCK_DGRAM)
        s.settimeout(2)
        payload = os.urandom(size)
        s.sendto(payload, (server, port))
        try:
            data, _ = s.recvfrom(65535)
            ok += data == payload
        except socket.timeout:
            pass
# A closed port: the ICMP port unreachable comes back as ECONNREFUSED.
s = socket.socket(socket.AF_INET6, socket.SOCK_DGRAM)
s.settimeout(2)
s.connect((server, 9))
s.send(b"x")
try:
    s.recv(16)
    refused = False
except ConnectionRefusedError:
    refused = True
except socket.timeout:
    refused = False
print(ok, refused)
EOF
# The server answers late, when the pod's socket is closed: the pod's port
# unreachable has to reach the server.
cat >"$WORK/udp-late.py" <<'EOF'
import socket, time
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.bind(("192.0.2.1", 5006))
data, peer = s.recvfrom(16)
s.connect(peer)
time.sleep(0.5)
s.send(b"late")
s.settimeout(2)
try:
    s.recv(16)
    print("answered")
except ConnectionRefusedError:
    print("refused")
except socket.timeout:
    print("timeout")
EOF
ns internet python3 "$WORK/udp-server.py" &
disown
ns internet timeout 10 python3 "$WORK/udp-late.py" >"$WORK/late" &
late_pid=$!
sleep 0.5
checksums=$(counter udp_checksums)
read -r ok refused < <(ns pod python3 "$WORK/udp-client.py" "$SERVER6")
if [ "$ok" = 6 ]; then pass "UDP echo: 6 of 6, with and without IPv4 checksums"; else fail "UDP echo: $ok of 6"; fi
computed=$(($(counter udp_checksums) - checksums))
if [ "$computed" = 3 ]; then pass "UDP: $computed checksums computed for IPv4 datagrams without one"; else fail "UDP: $computed checksums computed, not 3"; fi
if [ "$refused" = True ]; then pass "UDP to a closed port: port unreachable reaches the pod"; else fail "UDP to a closed port: no port unreachable"; fi
ns pod python3 -c "import socket, sys; socket.socket(socket.AF_INET6, socket.SOCK_DGRAM).sendto(b'x', (sys.argv[1], 5006))" "$SERVER6"
wait "$late_pid" || true
if [ "$(cat "$WORK/late")" = refused ]; then
	pass "UDP to the pod's closed port: its port unreachable reaches the server"
else
	fail "UDP to the pod's closed port: the server saw '$(cat "$WORK/late")'"
fi

echo "== ICMP errors"
ns pod ping -6 -c 1 -W 2 -t 2 "$SERVER6" >"$WORK/ttl2" 2>&1 || true
if grep -q 'From 64:ff9b::c633:6402.*Time exceeded' "$WORK/ttl2"; then
	pass "time exceeded from the node: $(grep -o 'From.*' "$WORK/ttl2" | head -1)"
else
	fail "no time exceeded from the node"
	cat "$WORK/ttl2"
fi
ns pod ping -6 -c 1 -W 2 -t 3 "$SERVER6" >"$WORK/ttl3" 2>&1 || true
if grep -q 'From 64:ff9b::c633:6401.*Time exceeded' "$WORK/ttl3"; then
	pass "time exceeded from the router, through the masquerade: $(grep -o 'From.*' "$WORK/ttl3" | head -1)"
else
	fail "no time exceeded from the router"
	cat "$WORK/ttl3"
fi

# The router's link to the internet shrinks to 1400 bytes; the server's
# stays at 1500, so the pod's segments outgrow it.
ns router ip link set r-inet mtu 1400
transfer "upload over MTU 1400" "nc -l -d $SERVER 5005 | sha256sum >$WORK/up1400" "nc -N $SERVER6 5005 <$WORK/data"
if [ "$(cat "$WORK/up1400")" = "$sum" ]; then pass "upload over MTU 1400 intact"; else fail "upload over MTU 1400 corrupt"; fi
pmtu=$(ns pod ip -6 route get "$SERVER6" | grep -o 'mtu [0-9]*' || true)
if [ "$pmtu" = "mtu 1420" ]; then
	pass "packet too big reached the pod: path $pmtu (1400 + 20)"
else
	fail "packet too big: the pod's path has '${pmtu:-no mtu}'"
fi
ns router ip link set r-inet mtu 1500

# The pod's link shrinks to 1400 bytes on the node's side: the node's packet
# too big, from no address that translates, reaches the server as
# fragmentation needed from the translator, masqueraded.
ns node ip link set pod-test mtu 1400
transfer "download over MTU 1400" "nc -l -N $SERVER 5007 <$WORK/data" "nc -d $SERVER6 5007 | sha256sum >$WORK/down1400"
if [ "$(cat "$WORK/down1400")" = "$sum" ]; then pass "download over MTU 1400 intact"; else fail "download over MTU 1400 corrupt"; fi
pmtu=$(ns internet ip route get "$NODE_UP" | grep -o 'mtu [0-9]*' || true)
if [ "$pmtu" = "mtu 1380" ]; then
	pass "fragmentation needed reached the server: path $pmtu (1400 - 20)"
else
	fail "fragmentation needed: the server's path has '${pmtu:-no mtu}'"
fi
ns node ip link set pod-test mtu 1500

echo "== Mappings"
no_mapping=$(counter no_mapping)
if ns pod ping -6 -c 2 -W 1 -I "$UNMAPPED" "$SERVER6" >/dev/null 2>&1; then
	fail "an unmapped address got through"
else
	pass "an unmapped pod is dropped ($(($(counter no_mapping) - no_mapping)) packets counted)"
fi
nat64 unmap "$POD"
if ns pod ping -6 -c 2 -W 1 "$SERVER6" >/dev/null 2>&1; then
	fail "unmap: still translating"
else
	pass "unmap stops the translation ($(nat64 list | wc -l) mappings left)"
fi
nat64 map "$POD" "$POD4"
if ns pod ping -6 -c 2 -W 2 "$SERVER6" >/dev/null 2>&1; then pass "map again: translating"; else fail "map again"; fi

echo "== Restart"
before=$(ns node tc filter show dev feos-nat64 egress | grep -o ' id [0-9]*')
ns pod ping -6 -i 0.01 -c 500 -W 1 "$SERVER6" >"$WORK/restart" 2>&1 &
ping_pid=$!
sleep 1
nat64 attach
sleep 1
nat64 attach
wait "$ping_pid" || true
after=$(ns node tc filter show dev feos-nat64 egress | grep -o ' id [0-9]*')
filters=$(ns node tc filter show dev feos-nat64 egress | grep -c handle || true)
received=$(grep -o '[0-9]* received' "$WORK/restart")
if [ "$received" = "500 received" ] && [ "$before" != "$after" ] && [ "$filters" = 1 ]; then
	pass "attach twice while pinging: $received of 500, program$before replaced by$after, one filter"
else
	fail "restart: $received of 500, program$before -> $after, $filters filters"
fi
if nat64 list | grep -q "^$POD $POD4\$"; then pass "the mapping survived: $(nat64 list)"; else fail "the mapping is gone"; fi

echo "== Counters"
nat64 stats

echo "== Detach"
nat64 detach
if ! ns node ip link show feos-nat64 >/dev/null 2>&1 && ! sudo test -e "$PIN_DIR"; then
	pass "detach removed the device and the pins"
else
	fail "detach left something"
fi

if [ "$FAILED" = 0 ]; then echo "All NAT64 tests passed."; else echo "NAT64 tests FAILED."; fi
exit "$FAILED"
