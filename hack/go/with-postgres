#!/usr/bin/env bash
# Runs a command with FERUN_TEST_DATABASE_URL naming a PostgreSQL: the one
# the environment names, or a throwaway one in docker, removed afterwards.
# The tests make a database of their own in it for each test.
set -euo pipefail

if [ -n "${FERUN_TEST_DATABASE_URL:-}" ]; then
	exec "$@"
fi

image=${FERUN_TEST_POSTGRES_IMAGE:-postgres:17-alpine}
name=ferun-test-pg-$$
docker run -d --rm --name "$name" -e POSTGRES_PASSWORD=ferun -e POSTGRES_USER=ferun \
	-p 127.0.0.1::5432 "$image" \
	-c fsync=off -c synchronous_commit=off -c full_page_writes=off -c max_connections=500 >/dev/null
trap 'docker rm -f "$name" >/dev/null 2>&1 || true' EXIT

port=$(docker port "$name" 5432/tcp | head -1 | sed 's/.*://')
for _ in $(seq 1 100); do
	if docker exec "$name" pg_isready -U ferun -q 2>/dev/null; then
		break
	fi
	sleep 0.2
done

export FERUN_TEST_DATABASE_URL="postgres://ferun:ferun@127.0.0.1:${port}/postgres?sslmode=disable"
"$@"
