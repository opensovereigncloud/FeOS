#!/bin/sh
# Stops feosd, its resolver's sockets and its VMs' unit when the package
# goes, not when it is upgraded. Its VMs keep running (KillMode=process);
# delete them first.
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl stop feosd.socket feosd.service feos-vms.service || true
fi
