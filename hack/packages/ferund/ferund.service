[Unit]
Description=FeRun control plane (ferund)
Documentation=https://github.com/ironcore-dev/FeOS
After=network-online.target postgresql.service
Wants=network-online.target
# ferund exits when it cannot reach its database at start. It is started
# again for as long as that lasts (a remote PostgreSQL after a power cycle
# or during a failover) and never given up on, as systemd's default start
# limit would after five starts in 10 s.
StartLimitIntervalSec=0

[Service]
Type=exec
User=ferun
Group=ferun
# FERUN_DATABASE_URL at least; the file describes the rest.
EnvironmentFile=/etc/ferun/ferund.env
ExecStart=/usr/bin/ferund serve
Restart=always
RestartSec=5
# On SIGTERM an instance keeps serving its requests and finishing its ops
# for up to --shutdown-grace (10 minutes by default), then closes its node
# connections. The stop timeout is that grace plus 30 s; a longer
# FERUN_SHUTDOWN_GRACE needs a drop-in with a longer TimeoutStopSec, or
# systemd kills ferund while tool calls are still in flight.
TimeoutStopSec=630
# ferund reads its CA directory and key files and writes nothing locally:
# its state is in PostgreSQL.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
