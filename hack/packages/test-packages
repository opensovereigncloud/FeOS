#!/bin/bash
# Install the packages (make packages) on Debian 13 with systemd, in a
# privileged container, and check feosd under systemd: its group and
# socket, a pod from the installed guest and Firecracker, its cgroup, a
# restart that keeps the pod, the refused self-upgrade, what autoremove
# keeps, a pod with a network and its forwarded services, removal, and a
# power-off through PID 1.
#
#   hack/packages/test-packages
#
# Needs docker, /dev/kvm, and internet access for the pod's image.
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
PACKAGES_DIR="${REPO_ROOT}/target/packages"
IMAGE="feos-test-packages"
NAME="feos-test-packages"
TIMEOUT=60

log() { printf '[test-packages] %s\n' "$*"; }
fail() {
  log "FAIL: $*"
  docker exec "${NAME}" journalctl -u feosd --no-pager -n 40 2>/dev/null || true
  docker exec "${NAME}" sh -c 'for c in . system.slice system.slice/feosd.service; do
    echo "$c: controllers $(cat /sys/fs/cgroup/$c/cgroup.controllers), subtree $(cat /sys/fs/cgroup/$c/cgroup.subtree_control)"
  done; journalctl -b --no-pager | grep -i -E "controller|cgroup" | head -10' 2>/dev/null || true
  exit 1
}
# Runs a command on the node. docker exec starts it in the root of the
# container's cgroup namespace, which, unlike a host's root, may hold no
# processes while systemd enables controllers below it: it moves into a
# cgroup of its own first.
in_node() {
  docker exec "${NAME}" sh -c \
    'mkdir -p /sys/fs/cgroup/exec && echo $$ >/sys/fs/cgroup/exec/cgroup.procs && exec "$@"' \
    sh "$@"
}
# Whether the input has a match. Unlike grep -q, it reads all of the
# input: a writer whose pipe closes early fails, and with it, under
# pipefail, the pipeline.
contains() { grep "$@" >/dev/null; }
export -f in_node contains
export NAME
# Waits until the command succeeds.
await() {
  local what="$1"
  shift
  for _ in $(seq $((TIMEOUT * 2))); do
    "$@" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  fail "${what}"
}

shopt -s nullglob
debs=("${PACKAGES_DIR}"/*.deb)
[ ${#debs[@]} -ge 6 ] || { log "missing packages; run make packages"; exit 1; }

log "building ${IMAGE}: Debian 13 with systemd"
docker build -q -t "${IMAGE}" - >/dev/null <<'EOF'
FROM debian:13
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv \
      iproute2 nftables && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
EOF

cleanup() { docker rm -f "${NAME}" >/dev/null 2>&1 || true; }
trap cleanup EXIT
cleanup
# /var/lib/feos is a volume: on a distribution it is on disk.
docker run -d --name "${NAME}" --privileged --cgroupns=private \
  --tmpfs /run --tmpfs /run/lock -v /var/lib/feos "${IMAGE}" >/dev/null
# Some units fail in a container: degraded is up, too.
await "systemd did not come up" bash -c \
  "in_node systemctl is-system-running --wait | contains -E '^(running|degraded)'"

log "installing ${debs[*]##*/}"
docker cp "${PACKAGES_DIR}/." "${NAME}:/opt/packages/"
in_node sh -c 'dpkg -i /opt/packages/*.deb' >/dev/null
# Type=notify: active once feosd's listeners are bound.
await "feosd is not active" in_node systemctl is-active feosd
in_node feosctl host version-info | contains "FeOS Version" || fail "no version"
log "feosd is active and answers on its socket"

[ "$(in_node stat -c '%G %a' /run/feos/api.sock)" = "feos 660" ] ||
  fail "the API socket is not the group feos's"
in_node useradd -m -G feos tester
in_node su tester -c 'feosctl host hostname' >/dev/null || fail "a member of feos cannot use the API"
log "the group feos may use the API socket"

leaf="$(in_node sh -c 'cat /proc/$(systemctl show -P MainPID feosd)/cgroup')"
[ "${leaf}" = "0::/system.slice/feosd.service/feosd" ] || fail "feosd runs in ${leaf}"

# A pod without containers: the installed guest in the installed
# Firecracker.
bare=11111111-2222-3333-4444-555555555555
microvm_pid() { in_node feosctl pod get "$1" | sed -n 's/^  MicroVM: pid \([0-9]*\),.*/\1/p'; }
export -f microvm_pid
in_node feosctl pod create --pod-id "${bare}" --memory 256 --wait >/dev/null ||
  fail "no pod from the installed guest"
pid="$(microvm_pid "${bare}")"
in_node grep -qx "${pid}" "/sys/fs/cgroup/system.slice/feosd.service/vms/${bare}/cgroup.procs" ||
  fail "Firecracker (pid ${pid}) is not in the pod's cgroup"
in_node grep -q '"firecracker":"/usr/lib/feos/firecracker/' \
  "/var/lib/feos/vms/firecracker/${bare}/jail.json" || fail "the pod does not run the installed Firecracker"
log "a pod boots the installed guest, in system.slice/feosd.service/vms/${bare}"

in_node systemctl restart feosd
await "feosd did not come back" in_node systemctl is-active feosd
in_node test -d "/proc/${pid}" || fail "the restart ended the pod's microVM"
await "the restarted feosd does not take the pod over" bash -c \
  "[ \"\$(microvm_pid ${bare})\" = ${pid} ]"
in_node feosctl pod get "${bare}" | contains "State: RUNNING" || fail "the pod is not running"
log "the pod outlived a restart of feosd, which took it over"

if in_node feosctl host upgrade http://127.0.0.1/feosd 2>/tmp/upgrade.err; then
  fail "feosd took an upgrade without --self-upgrade"
fi
log "feosd refuses to replace its own binary"

# With every package installed as a dependency, autoremove would take all
# of them but the versions of Firecracker and the guest.
in_node apt-mark auto feosd feosctl feos-firecracker feos-guest \
  "$(in_node dpkg-query -W -f '${Package}\n' 'feos-firecracker-*')" \
  "$(in_node dpkg-query -W -f '${Package}\n' 'feos-guest-*')" >/dev/null
removed="$(in_node apt-get -s autoremove | sed -n 's/^Remv \([^ ]*\).*/\1/p' | sort | tr '\n' ' ')"
in_node apt-mark manual feosd feosctl >/dev/null
[ "${removed}" = "feos-firecracker feos-guest feosctl feosd " ] ||
  fail "autoremove would remove ${removed}"
log "autoremove keeps the versions of Firecracker and the guest"

in_node feosctl pod delete "${bare}" >/dev/null
in_node test ! -e "/sys/fs/cgroup/system.slice/feosd.service/vms/${bare}" ||
  fail "the pod's cgroup outlived it"

# Pods with feosd's network (ADR 0010): the image comes through its NAT.
pod=22222222-3333-4444-5555-666666666666
other=33333333-3333-4444-5555-666666666666
pod_state() { in_node feosctl pod get "${pod}" | sed -n 's/^  State: //p'; }
pod_address() { in_node feosctl pod get "$1" | sed -n 's/^  Address: //p'; }
in_pod() { in_node feosctl container --pod "${pod}" exec main -- "$@"; }
for id in "${pod}" "${other}"; do
  in_node feosctl pod create --pod-id "${id}" --image docker.io/library/busybox:1.36 --wait \
    -- sleep 3600 >/dev/null || fail "pod ${id} did not come up: $(in_node feosctl pod get "${id}")"
done
in_node feosctl pod get "${pod}" | contains "main (docker.io/library/busybox:1.36): running" ||
  fail "the pod's container does not run"
[ "$(in_pod echo forwarded)" = forwarded ] || fail "no exec in the pod through feosd"
in_node feosctl image --pod "${pod}" list | contains busybox || fail "the pod's images are not listed"
if in_node feosctl container exec main -- true 2>/dev/null; then
  fail "a call without the pod reached the pod"
fi
log "a pod pulled its image and runs; feosd forwards its services"

# A connection that is dropped runs into nc's timeout of 3 s; one that
# gets through is refused at once, nothing listens on port 9.
dropped() {
  local start=${SECONDS}
  in_pod nc -w 3 "$1" 9 </dev/null >/dev/null 2>&1 || true
  [ $((SECONDS - start)) -ge 2 ]
}
# What the check sees when nothing drops: the pod's own address refuses.
dropped "$(pod_address "${pod}")" && fail "a refused connection looks dropped"
other_address="$(pod_address "${other}")"
case "${other_address}" in 10.200.*) ;; *) fail "pod ${other} has the address ${other_address}" ;; esac
dropped "${other_address}" || fail "a pod reaches another pod"
dropped 10.200.0.1 || fail "a pod reaches the node"
in_node nft list table bridge feos | contains "ether saddr != 06:00:ac" ||
  fail "no rules pin the pods' addresses"
in_node nft list table inet feos | contains masquerade || fail "no NAT for the pods"
in_pod wget -q -T 10 -O /dev/null http://example.com/ || fail "a pod does not reach the internet"
in_node feosctl pod delete "${other}" >/dev/null
log "pods reach the internet, but neither each other nor the node; their addresses are pinned"

in_node feosctl pod create --pod-id "${pod}" --image docker.io/library/busybox:1.36 \
  -- sleep 3600 >/dev/null ||
  fail "a create of the same pod again failed"
if in_node feosctl pod create --pod-id "${pod}" --image docker.io/library/alpine:3 >/dev/null 2>&1; then
  fail "a create of the pod with another spec went through"
fi

in_pod sh -c 'echo kept >/tmp/mark'
in_node feosctl pod suspend "${pod}" >/dev/null || fail "no suspend"
[ "$(pod_state)" = SUSPENDED ] || fail "the pod is $(pod_state), not suspended"
in_node feosctl pod resume "${pod}" >/dev/null || fail "no resume"
[ "$(in_pod cat /tmp/mark)" = kept ] || fail "the pod lost its memory in a suspend"
log "a pod suspends and resumes with its containers"

in_node systemctl restart feosd
await "feosd did not come back" in_node systemctl is-active feosd
[ "$(pod_state)" = RUNNING ] || fail "after a restart of feosd, the pod is $(pod_state)"
[ "$(in_pod cat /tmp/mark)" = kept ] || fail "the pod did not outlive a restart of feosd"
log "the pod outlived a restart of feosd"

in_node feosctl pod stop "${pod}" >/dev/null || fail "no stop"
[ "$(pod_state)" = STOPPED ] || fail "the pod is $(pod_state), not stopped"
in_node feosctl pod start --wait "${pod}" >/dev/null || fail "the pod did not come up again"
[ "$(in_pod echo again)" = again ] || fail "no exec after a start"
log "a stopped pod comes up again"

in_node feosctl pod delete "${pod}" >/dev/null
in_node feosctl pod list | contains "${pod}" && fail "the pod outlived its delete"
in_node test -e "/var/lib/feos/vms/firecracker/${pod}" && fail "the pod's microVM outlived its delete"
log "a pod is deleted with its microVM"

in_node dpkg -r feosd >/dev/null
if in_node systemctl is-active feosd >/dev/null 2>&1; then fail "feosd runs after its removal"; fi
in_node sh -c 'dpkg -i /opt/packages/feosd_*.deb' >/dev/null
await "feosd is not active again" in_node systemctl is-active feosd
log "removing the package stops feosd, installing it starts it"

in_node feosctl host shutdown >/dev/null || true
for _ in $(seq $((TIMEOUT * 2))); do
  [ "$(docker inspect -f '{{.State.Running}}' "${NAME}")" = false ] && break
  sleep 0.5
done
[ "$(docker inspect -f '{{.State.Running}}' "${NAME}")" = false ] || fail "systemd did not power off"
log "Shutdown powers the node off through systemd"
log "PASS"
