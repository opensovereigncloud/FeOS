#!/usr/bin/env bash
# Build the guest's blank data volume (ADR 0011): the ext4 filesystem every
# pod's disk starts from. feosd has diskd import it once as the disk's L0;
# the guest mounts it at /var/lib/feos. No root needed.
#
#   hack/guest/data/mk-data [SIZE]
#
# Output: target/guest/data.img.zst, zstd-compressed: an 8 GiB filesystem
# holds 6 MiB, and its inode tables and journal are zeroes already, so that
# the guest's kernel writes none at the first mount. Every build makes the
# same image (a fixed UUID, hash seed and time), so that nodes import the
# same layer.
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
OUT_DIR="${OUT_DIR:-${REPO_ROOT}/target/guest}"
OUT="${OUT_DIR}/data.img.zst"
SIZE="${1:-8G}"
MKFS="$(command -v mkfs.ext4 || echo /sbin/mkfs.ext4)"

log() { printf '[mk-data] %s\n' "$*"; }

mkdir -p "${OUT_DIR}"
IMG="$(mktemp "${OUT_DIR}/data.XXXXXX.img")"
trap 'rm -f "${IMG}"' EXIT
truncate -s "${SIZE}" "${IMG}"
log "making a blank ext4 of ${SIZE}"
E2FSPROGS_FAKE_TIME=1700000000 "${MKFS}" -q -F -L feos-data \
    -U 5e3d1f2a-7c41-4b6e-9a0d-feed00da7a00 \
    -E lazy_itable_init=0,lazy_journal_init=0,hash_seed=5e3d1f2a-7c41-4b6e-9a0d-feed00da7a01,root_owner=0:0 \
    "${IMG}"
zstd -q -f -T0 -9 "${IMG}" -o "${OUT}"
chmod 0644 "${OUT}"
log "$(du -h "${OUT}" | cut -f1) in ${OUT}"
