#!/bin/sh
# SPDX-FileCopyrightText: SAP SE or an SAP affiliate company and IronCore contributors
# SPDX-License-Identifier: Apache-2.0

# Installs FeOS on the Garden Linux node this pod runs on, as the init
# container of the feos DaemonSet. Garden Linux's /usr is read-only and it
# has no apt to install with, so the packages of the image (feosd, diskd,
# feosctl, Firecracker, the guest) become a systemd system extension: their
# /usr, unpacked into /var/lib/extensions/feos-<version>, which
# systemd-sysext lays over the host's /usr. Their files land where the
# packages put them on Debian (ADR 0009), and systemd runs feosd and diskd
# as the host's services, as on any Debian node. The pod only installs:
# their pods and disks outlive this pod, a rollout and the DaemonSet.
#
# A new version's extension takes over the Firecracker and guest versions
# of the one before, so that pods keep booting, resuming and restoring
# with what they started with, as packages installed side by side do.
#
# The host is reached through PID 1's namespaces (hostPID), and its files
# through the hostPath mounts under /host.
set -eu

log() { echo "install: $*"; }
on_host() { nsenter -t 1 -m -u -i -n -p -- "$@"; }

: "${NODE_NAME:?}"
version=$(cat /feos/version)
# An extension's name is a file name: Debian's ~ is not allowed in it.
name="feos-$(echo "$version" | tr '~' '-')"
ext=/host/var/lib/extensions
# Where an extension is put together, and where the ones before wait until
# systemd-sysext let go of them: outside $ext, on the same filesystem.
work=/host/var/lib/feos-sysext

# The extension of this version, unless it is there already.
mkdir -p "$ext" "$work"
if [ ! -d "$ext/$name" ]; then
	new="$work/$name.new"
	rm -rf "$new"
	mkdir -p "$new"
	# The versions before stay beside the new one: hard links, the same
	# filesystem.
	for old in "$ext"/feos-*; do
		[ -d "$old/usr/lib/feos" ] || continue
		mkdir -p "$new/usr/lib/feos"
		cp -al "$old/usr/lib/feos/." "$new/usr/lib/feos/"
	done
	# /usr of every package; their /etc is apt's and the defaults below.
	# The meta packages (feos-guest, feos-firecracker) have no files.
	for deb in /feos/debs/*.deb; do
		rm -rf /tmp/unpack && mkdir /tmp/unpack
		dpkg-deb -x "$deb" /tmp/unpack
		if [ -d /tmp/unpack/usr ]; then
			mkdir -p "$new/usr"
			cp -a /tmp/unpack/usr/. "$new/usr/"
		fi
	done
	rm -rf /tmp/unpack
	mkdir -p "$new/usr/lib/extension-release.d"
	cat >"$new/usr/lib/extension-release.d/extension-release.$name" <<EOF
ID=_any
ARCHITECTURE=x86-64
EOF
	# One FeOS extension at a time: the older ones leave once the new one
	# is complete.
	for old in "$ext"/feos-*; do
		[ -d "$old" ] || continue
		mv "$old" "$work/$(basename "$old").old"
	done
	mv "$new" "$ext/$name"
	log "extension $name ready"
fi

# Lays the extension over /usr, and reloads systemd for its units.
on_host systemd-sysext refresh
rm -rf "$work"/feos-*.old
on_host systemd-sysusers feosd.conf
on_host modprobe ublk_drv
mkdir -p /host/etc/modules-load.d
echo ublk_drv >/host/etc/modules-load.d/feos-diskd.conf

# What pods may not reach: the nodes' and the cluster's networks.
deny=""
for p in ${DENY_PREFIXES:-}; do
	deny="$deny --deny-prefix $p"
done

# Without a control plane, a ULA of this node's own, which no other node
# reaches; with one, the node is on its cluster's mesh (ADR 0017).
pod_prefix=""
control_plane=""
if [ -n "${CONTROL_PLANE:-}" ]; then
	control_plane="--control-plane $CONTROL_PLANE --control-plane-name $CONTROL_PLANE_NAME --trust-domain $TRUST_DOMAIN"
else
	octet=${NODE_IP##*.}
	pod_prefix="--pod-prefix $(printf 'fd00:fe05:%x::/64' "$octet")"
fi

umask 077
mkdir -p /host/etc/feos
# A node joins with the token of its name, once: afterwards its key and
# certificate are in /var/lib/feos/node, and the token is used up.
if [ -s "/join/$NODE_NAME" ]; then
	cp "/join/$NODE_NAME" /host/etc/feos/join-token.new
	mv /host/etc/feos/join-token.new /host/etc/feos/join-token
fi

changed=false
# Writes a file on the host if its content changed.
put() {
	if ! cmp -s "$2" "/host$1" 2>/dev/null; then
		mv "$2" "/host$1"
		changed=true
		log "wrote $1"
	else
		rm -f "$2"
	fi
}

cat >/tmp/feosd <<EOF
# Written by the feos DaemonSet (deploy/gardener/feos); edits are overwritten.
FEOSD_ARGS="$pod_prefix$deny $control_plane"
EOF
put /etc/default/feosd /tmp/feosd

cat >/tmp/diskd <<EOF
# Written by the feos DaemonSet (deploy/gardener/feos); edits are overwritten.
DISKD_ARGS="${DISKD_ARGS:-}"
S3_BUCKET="${S3_BUCKET:-}"
AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-}"
AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-}"
AWS_ENDPOINT_URL="${AWS_ENDPOINT_URL:-}"
AWS_REGION="${AWS_REGION:-}"
DISKD_S3_PREFIX="${DISKD_S3_PREFIX:-}"
EOF
put /etc/default/diskd /tmp/diskd

# The version that runs, by the binary's identity: a new extension or new
# configuration restarts them, as the packages' scripts and the k3s
# install do. Neither stops a pod: their units keep the VMs and the disks
# (KillMode=process).
on_host systemctl enable diskd.service feosd.service
running=$(cat /host/var/lib/feos/.installed 2>/dev/null || true)
if [ "$running" != "$name" ] || [ "$changed" = true ] ||
	! on_host systemctl is-active --quiet diskd.service feosd.service; then
	log "starting diskd and feosd $version"
	on_host systemctl restart diskd.service
	# A feosd from before feosd.socket held the resolver's address itself.
	if ! on_host systemctl is-active --quiet feosd.socket; then
		on_host systemctl stop feosd.service
	fi
	on_host systemctl restart feosd.service
	mkdir -p /host/var/lib/feos
	echo "$name" >/host/var/lib/feos/.installed
fi
on_host systemctl is-active --quiet diskd.service feosd.service
log "feosd and diskd run: $version"
