# The parameters of the Gardener deployment (README.md). Copy this file to
# config.env, which git ignores, and set the values: the Makefile reads it
# and fills them in where the manifests say ${NAME}. A variable on make's
# command line wins over the file. One NAME=value a line, without quotes.

# The DNS zone of the front doors, e.g. example.com: ferund at
# run.<DOMAIN>, FeChat at chat.<DOMAIN>, the registry at oci.<DOMAIN>.
# run.<DOMAIN> is FeRun's trust domain too (ferund init-ca).
DOMAIN=

# The registry the images are pushed to and pulled from. Default:
# oci.<DOMAIN>, the one of registry/.
#REGISTRY=

# The OpenID Connect provider people sign in with to ferund and FeChat,
# exactly as its discovery document states it, e.g. https://id.example.com/.
OIDC_ISSUER=

# The worker pool whose workers run FeOS: its label
# worker.gardener.cloud/pool.
WORKER_POOL=

# The beginning of the pool's node names (kubectl get nodes), on IronCore
# shoot--<project>--<shoot>-. feos-k8s removes a node from FeRun only if
# its name begins with it.
NODE_NAME_PREFIX=

# The fixed ClusterIP of the service ferund-nodes, which feosd dials: a
# free address of the shoot's service network (spec.networking.services).
FERUN_NODES_IP=

# FeChat's model, as the LLM gateway names it.
FECHAT_MODEL=
